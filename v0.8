.0}},{"name":"Montreal","difficulty":3,"openness":0.9,"star_bias":-0.05,"genre_weights":{"indie":2.5,"art_pop":2.5,"electronic":2.0,"dance":1.5,"rock":1.0,"pop":0.5},"audience_weights":{"indie_alt":2.0,"cult":1.5,"festival":1.0,"mainstream":-0.25}},{"name":"Tokyo","difficulty":4,"openness":0.75,"star_bias":0.15,"genre_weights":{"pop":2.0,"kpop":2.5,"electronic":2.0,"rock":1.5,"art_pop":1.5,"hiphop":1.0,"country":-1.5,"jpop":2.8},"audience_weights":{"global":2.0,"younger":1.5,"mainstream":1.0,"dance_party":1.0}},{"name":"Melbourne","difficulty":3,"openness":0.9,"star_bias":-0.05,"genre_weights":{"indie":2.5,"psych":2.5,"rock":1.5,"electronic":1.5,"dance":1.0,"alt_pop":1.5},"audience_weights":{"indie_alt":2.0,"festival":1.5,"guitar_rock":1.0,"cult":1.0}}],"marketFlavor":{"New York":{"teaser":"New York wants a bill with point of view. Big names travel, but so do sharp left turns, late-night energy, and artists who feel culturally current.","refs":["Yeah Yeah Yeahs","A$AP Rocky","The Roots","St. Vincent"]},"Los Angeles":{"teaser":"Los Angeles responds to star power, spectacle, and whatever feels one step ahead of the rest of the country. A little cool-factor never hurts.","refs":["Billie Eilish","Tyler, the Creator","HAIM","The Marías"]},"Chicago":{"teaser":"Chicago has deep musical memory and broad ears. It rewards substance, hometown credibility, dance-floor energy, and bands that can really play.","refs":["Chance the Rapper","Wilco","Common","Smino"]},"Nashville":{"teaser":"Nashville listens closely to the song. Big voices, lived-in storytelling, rootsy credibility, and crowd-wide singalongs tend to travel well here.","refs":["Chris Stapleton","Kacey Musgraves","Maren Morris","Margo Price"]},"Austin":{"teaser":"Austin likes a lineup that can roam. Strong songs, guitars, grooves, psychy detours, and a little weirdness all have room on the same field.","refs":["Gary Clark Jr.","Spoon","Willie Nelson","Black Pumas"]},"Atlanta":{"teaser":"Atlanta expects confidence. Rhythm, charisma, crossover instincts, and artists who can command a huge crowd tend to get attention fast.","refs":["Usher","Future","21 Savage","Mastodon"]},"Miami":{"teaser":"Miami wants heat: movement, hooks, nightlife energy, and artists who make the weekend feel bigger than the stage itself.","refs":["Gloria Estefan","Rick Ross","Camila Cabello","DJ Khaled"]},"Denver":{"teaser":"Denver is adventurous and communal. Warm songwriting, expansive live sets, danceable late nights, and outdoorsy festival energy can all connect.","refs":["Nathaniel Rateliff","ODESZA","String Cheese Incident","Big Gigantic"]},"Seattle":{"teaser":"Seattle rewards edge, atmosphere, authenticity, and artists with a strong identity. Bland is a tougher sell than strange.","refs":["Pearl Jam","Death Cab for Cutie","Fleet Foxes","Macklemore"]},"Detroit":{"teaser":"Detroit brings strong opinions and deep music pride. Groove, grit, soul, electronic edge, and hometown credibility all matter.","refs":["Eminem","Big Sean","Jack White","Danny Brown"]},"New Orleans":{"teaser":"New Orleans wants personality and musicianship. If an artist can turn a set into a celebration, the city usually notices.","refs":["Trombone Shorty","Tank and the Bangas","Galactic","Big Freedia"]},"Boston":{"teaser":"Boston still likes conviction: memorable songs, loud guitars, punchy live sets, and artists who feel like they mean it.","refs":["Pixies","Dropkick Murphys","Aerosmith","Clairo"]},"Philadelphia":{"teaser":"Philadelphia crowds respond to personality, soul, lyrical bite, and acts that feel alive rather than over-polished.","refs":["The Roots","Meek Mill","Japanese Breakfast","Kurt Vile"]},"Baltimore":{"teaser":"Baltimore likes a bill with conviction: hometown energy, sharp personalities, big singalongs, and artists who can bridge the city and the county without sanding off their edges.","refs":["JPEGMAFIA","Turnstile","Future Islands","Brittany Howard"]},"Las Vegas":{"teaser":"Las Vegas wants an event. Big hooks, spectacle, nightlife energy, and recognizable personalities all play well under the lights.","refs":["Imagine Dragons","Panic! at the Disco","Shamir","The Cab"]},"San Juan":{"teaser":"San Juan wants movement, swagger, huge personalities, and songs that turn an open field into a party. Local pride runs especially deep, and the room notices when a booking feels connected to the island.","refs":["Rauw Alejandro","Young Miko","Daddy Yankee","Residente"]},"London":{"teaser":"London has broad taste and very little patience for a boring bill. Legacy, club culture, sharp songwriting, and the next new thing can all coexist.","refs":["Blur","Little Simz","The xx","Sam Fender"]},"Berlin":{"teaser":"Berlin values credibility and discovery. Nightlife energy, experimentation, and artists with a distinct edge can matter as much as pure fame.","refs":["Paul Kalkbrenner","Modeselektor","Ellen Allien","Nina Kraviz"]},"Mexico City":{"teaser":"Mexico City is huge, passionate, and musically curious. Big communal moments matter, but adventurous and left-field bookings can become heroes too.","refs":["Café Tacvba","Natalia Lafourcade","Zoé","Molotov"]},"Toronto":{"teaser":"Toronto likes polish without predictability. Smooth crossover appeal, sharp songwriting, late-night energy, and something a little left of center can all work.","refs":["Drake","The Beaches","Feist","Daniel Caesar"]},"Montreal":{"teaser":"Montreal leans artful and eclectic. Atmosphere, experimentation, independent spirit, and dance-floor instincts all find receptive ears.","refs":["Godspeed You! Black Emperor","Men I Trust","Charlotte Cardin","Patrick Watson"]},"Tokyo":{"teaser":"Tokyo rewards polish, novelty, precision, and spectacle. A distinctive visual or sonic identity can travel almost as far as a famous name.","refs":["Perfume","YOASOBI","Cornelius","One Ok Rock"]},"Melbourne":{"teaser":"Melbourne loves live music and independent personality. Guitars, grooves, dance-floor energy, and oddball choices can comfortably share a bill.","refs":["King Gizzard & the Lizard Wizard","Courtney Barnett","Amyl and the Sniffers","The Avalanches"]}}};</script>
<script>
(function(){
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
const jaccard=(a,b)=>{const A=new Set(a||[]),B=new Set(b||[]);if(!A.size&&!B.size)return 0;let n=0;A.forEach(x=>{if(B.has(x))n++});return n/(new Set([...A,...B]).size||1)};
function pairOverlap(a,b){return .74*jaccard(a.audience_tags,b.audience_tags)+.26*jaccard(a.genres,b.genres)}
function overlapPenalty(lineup){let t=0;for(let i=0;i<lineup.length;i++)for(let j=i+1;j<lineup.length;j++){const s=pairOverlap(lineup[i].artist,lineup[j].artist);if(s>.32)t+=(s-.32)*5.0}return clamp(t,0,8)}
function marketSignal(artist,market){const gs=(artist.genres||[]).map(g=>market.genre_weights[g]||0).sort((a,b)=>b-a);const g=gs.length?((gs[0]||0)+(.55*(gs[1]||0))):0;const as=(artist.audience_tags||[]).map(t=>market.audience_weights[t]||0).sort((a,b)=>b-a);const aud=as.length?(as[0]||0)+(.30*(as[1]||0)):0;const home=(artist.home_market_boosts||{})[market.name]||0;return g*.82+aud*.65+home*.60}
function marketBaseline(market){const pool=window.FESTIVAL_DATA.artists.filter(a=>a.default_pool!==false);return pool.reduce((s,a)=>s+marketSignal(a,market),0)/(pool.length||1)}
function localFit(lineup,market){const total=lineup.reduce((s,x)=>s+x.artist.draw_power,0)||1;const weighted=lineup.reduce((s,x)=>s+marketSignal(x.artist,market)*x.artist.draw_power,0)/total;return clamp((weighted-marketBaseline(market))*5.2,-12,14)}
function marqueeDraw(d){const x=Math.max(0,d-90);return d+.70*x+.11*x*x}
function intrinsic(lineup){const ws=[.26,.22,.19,.17,.16];const ds=[...lineup].map(x=>marqueeDraw(x.artist.draw_power)).sort((a,b)=>b-a);const raw=ds.reduce((s,d,i)=>s+d*(ws[i]||0),0);let value=raw*1.72-56;if(raw>76)value+=.76*Math.pow(raw-76,2);return clamp(value,32,99)}
function score(lineup,market){const base=intrinsic(lineup),fit=localFit(lineup,market),overlap=overlapPenalty(lineup);const final=clamp(base+fit-overlap,0,100);const tickets=Math.round((.30+.70*final/100)*50000);const profitM=(final-72.5)*.20;return{intrinsic:+base.toFixed(1),localFit:+fit.toFixed(1),overlapPenalty:+overlap.toFixed(1),finalScore:+final.toFixed(1),tickets,profitM:+profitM.toFixed(2)}}
const STAR_PRICE_BALANCE={'Prince':-5,'Rihanna':-3,'Bob Marley':-5,'Beyonce':-2};
function gamePrice(artist,phase,rng=Math.random){let p=artist.base_price_v03||artist.base_price_v02||artist.base_price||20;p*=.96+rng()*.08;if(phase===1)p-=Math.min(5,p*.12);else if(phase===2)p-=Math.min(3,p*.07);let out=Math.max(4,Math.round(p));if(artist.draw_power>=99)out=Math.max(54,out);else if(artist.draw_power>=97)out=Math.max(51,out);else if(artist.draw_power>=95)out=Math.max(45,out);out+=STAR_PRICE_BALANCE[artist.name]||0;return Math.max(4,out)}
function maxFuturePrice(artist){let p=(artist.base_price_v03||artist.base_price_v02||artist.base_price||20)*1.04;let out=Math.max(4,Math.round(p));if(artist.draw_power>=99)out=Math.max(54,out);else if(artist.draw_power>=97)out=Math.max(51,out);else if(artist.draw_power>=95)out=Math.max(45,out);out+=STAR_PRICE_BALANCE[artist.name]||0;return Math.max(4,out)}
function futureReserveCost(artists,burned,slots){if(slots<=0)return 0;const costs=artists.filter(a=>a.default_pool!==false&&!burned.has(a.name)).map(maxFuturePrice).sort((a,b)=>a-b);if(costs.length<slots)return Infinity;return costs.slice(0,slots).reduce((a,b)=>a+b,0)}
function classifyPrice(p){if(p>=42)return'premium';if(p>=19)return'mid';return'value'}
function chooseOffer(artists,remaining,phase,used,rng=Math.random,slotsRemaining=6-phase){const counts={1:5,2:5,3:4,4:3,5:3},target=counts[phase]||3;const avail=artists.filter(a=>a.default_pool!==false&&!used.has(a.name));const priced=avail.map(a=>({artist:a,price:gamePrice(a,phase,rng)}));const groups={premium:[],mid:[],value:[]};priced.forEach(x=>groups[classifyPrice(x.price)].push(x));const templates=[['premium','mid','value'],['premium','mid','mid'],['mid','mid','value'],['premium','premium','value']];const weights=[.48,.26,.21,.05];let r=rng(),acc=0,tpl=templates[0];for(let i=0;i<weights.length;i++){acc+=weights[i];if(r<=acc){tpl=templates[i];break}}const out=[],chosen=new Set();const maxDiscovery=target>=5?2:1;for(const t of tpl){let pool=groups[t].filter(x=>!chosen.has(x.artist.name));if(out.filter(z=>z.artist.recognition_tier==='discovery').length>=maxDiscovery)pool=pool.filter(x=>x.artist.recognition_tier!=='discovery');if(pool.length){const x=pool[Math.floor(rng()*pool.length)];out.push(x);chosen.add(x.artist.name)}}while(out.length<target){let pool=priced.filter(x=>!chosen.has(x.artist.name));if(out.filter(z=>z.artist.recognition_tier==='discovery').length>=maxDiscovery)pool=pool.filter(x=>x.artist.recognition_tier!=='discovery');if(!pool.length)break;const x=pool[Math.floor(rng()*pool.length)];out.push(x);chosen.add(x.artist.name)}const futureSlots=Math.max(0,slotsRemaining-1);const needed=phase<=2?Math.min(3,target):phase>=4?2:1;function markSafety(list){const burned=new Set([...used,...list.map(x=>x.artist.name)]);const reserve=futureReserveCost(artists,burned,futureSlots);return list.map(x=>x.price<=remaining&&remaining-x.price>=reserve)}let safety=markSafety(out);let guard=0;while(safety.filter(Boolean).length<needed&&guard++<target*4){let best=null;const candidates=priced.filter(x=>!chosen.has(x.artist.name)).sort((a,b)=>a.price-b.price);for(const cand of candidates.slice(0,30)){for(let idx=0;idx<out.length;idx++){const trial=[...out];trial[idx]=cand;const trialSafety=markSafety(trial);const safeCount=trialSafety.filter(Boolean).length;if(!best||safeCount>best.safeCount||(safeCount===best.safeCount&&cand.price<best.cand.price))best={cand,idx,safeCount,trialSafety};if(safeCount>=needed)break}if(best&&best.safeCount>=needed)break}if(!best||best.safeCount<=safety.filter(Boolean).length)break;chosen.delete(out[best.idx].artist.name);out[best.idx]=best.cand;chosen.add(best.cand.artist.name);safety=best.trialSafety}safety=markSafety(out);out.forEach((x,i)=>x.safe=safety[i]);for(let i=out.length-1;i>0;i--){const j=Math.floor(rng()*(i+1));[out[i],out[j]]=[out[j],out[i]]}return out}
function topMarketGenres(market){return Object.entries(market.genre_weights).sort((a,b)=>b[1]-a[1]).filter(x=>x[1]>0).slice(0,4).map(x=>x[0])}
function chooseMarket(markets,lineup,recent,rng=Math.random){let pool=markets.filter(m=>!recent.includes(m.name));if(!pool.length)pool=markets;const weighted=pool.map(m=>{const avg=lineup.reduce((s,x)=>s+marketSignal(x.artist,m),0)/(lineup.length||1);const influence=clamp(avg,-2,5)*.018;return{m,w:1+influence}});let total=weighted.reduce((s,x)=>s+x.w,0),r=rng()*total;for(const x of weighted){r-=x.w;if(r<=0)return x.m}return weighted[weighted.length-1].m}
window.FestivalEngine={score,chooseOffer,marketSignal,topMarketGenres,chooseMarket,overlapPenalty,localFit,intrinsic};
})();
