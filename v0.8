function sample(a){return a[Math.floor(Math.random()*a.length)]}
function fmtMoneyM(m){const sign=m>=0?'+':'−';return sign+'$'+Math.abs(m).toFixed(2)+'M '+(m>=0?'profit':'loss')}
const GENRE_LABELS={rnb:'R&B',hiphop:'Hip-Hop',kpop:'K-Pop',alt_pop:'Alt-Pop',art_pop:'Art Pop',post_punk:'Post-Punk',pop_punk:'Pop-Punk',alt_rock:'Alt-Rock',classic_rock:'Classic Rock',hard_rock:'Hard Rock',singer_songwriter:'Singer-Songwriter',indie_folk:'Indie Folk',indie_rock:'Indie Rock',indie_pop:'Indie Pop',latin_pop:'Latin Pop',jpop:'J-Pop',regional_mexican:'Regional Mexican'};
function prettyGenre(g){return GENRE_LABELS[g]||g.replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase())}
function cityAccent(name){const palette=['#d95d39','#375f4a','#365f8d','#9a5a73','#9a7227','#4f6b3a','#805432'];let h=0;for(const c of name||'')h=(h*31+c.charCodeAt(0))>>>0;return palette[h%palette.length]}
function genreCount(keys){return state.lineup.reduce((n,x)=>n+(x.artist.genres||[]).some(g=>keys.includes(g))?1:0,0)}
function festivalReference(s){if(s.finalScore<82)return'';const city=state.market.name;const electronic=genreCount(['electronic','dance','edm','house','techno']);const mixed=new Set(state.lineup.flatMap(x=>x.artist.genres||[])).size>=7;
if(city==='Austin'&&s.finalScore>=84)return'📰 Move over, ACL? Austin may have another festival worth circling on the calendar.';
if(city==='Chicago'&&s.finalScore>=86)return'📰 Lollapalooza has company: Chicago just found another bill with national pull.';
if(city==='Miami'&&electronic>=2&&s.finalScore>=85)return'📰 Ultra has company, this lineup gives Miami another reason to stay out late.';
if(city==='New Orleans'&&s.finalScore>=85)return'📰 Jazz Fest owns the history. Festival Season just made a case for a new tradition.';
if(city==='New York'&&s.finalScore>=87)return'📰 Governors Ball has company: New York has another festival people are arguing about.';
if(city==='Philadelphia'&&genreCount(['hiphop','rnb','soul'])>=2&&s.finalScore>=84)return'📰 Roots Picnic energy, a different poster: Philly responds to a festival with a point of view.';
if((city==='Los Angeles'||city==='Las Vegas')&&s.finalScore>=95)return'📰 Coachella-sized buzz follows this debut.';
if(mixed&&s.finalScore>=90)return'📰 The crossover appeal feels closer to Bonnaroo than a niche weekend.';
if(mixed&&s.finalScore>=84)return'📰 A broad bill gives this the kind of cross-genre pull that made festivals like Firefly memorable.';
if((city==='Baltimore'||city==='Philadelphia')&&s.finalScore>=83)return'📰 Mid-Atlantic crossover appeal gives the weekend a little Oceans Calling energy, without the boardwalk.';
return''}
const VERIFIED_SPOTIFY={"The Beatles":"https://open.spotify.com/artist/3WrFJ7ztbogyGnTHbHJFl2","Daft Punk":"https://open.spotify.com/artist/4tZwfgrHOc3mvqYlEYSvVi","Radiohead":"https://open.spotify.com/artist/4Z8W4fKeB5YxbusRsdQVPb","Bad Bunny":"https://open.spotify.com/artist/4q3ewBCX7sLwd24euuV69X","Bon Iver":"https://open.spotify.com/artist/4LEiUm1SRbFMgfqnQTwUbQ","Fleetwood Mac":"https://open.spotify.com/artist/08GQAI4eElDnROBrJRGE0X","Pitbull":"https://open.spotify.com/artist/46h5N3VjNxO3BqP91zw8mj","The Killers":"https://open.spotify.com/artist/0C0XlULifJtAgn6ZNCW2eu","Taylor Swift":"https://open.spotify.com/artist/06HL4z0CvFAxyc27GXpf02","Michael Jackson":"https://open.spotify.com/artist/3fMbdgg4jU18AjLCKBhRSm","Beyonce":"https://open.spotify.com/artist/6vWDO969PvNqNYHIOW5v0m","Queen":"https://open.spotify.com/artist/1dfeR4HaWDbWqFHLkxsg1d","Elton John":"https://open.spotify.com/artist/3PhoLpVuITZKcymswpck5b","Prince":"https://open.spotify.com/artist/5a2EaR3hamoenG9rDuVn8j","Led Zeppelin":"https://open.spotify.com/artist/36QJpDe2go2KgaRleHCDTp"};
const WIKI_TITLES={"Beyonce":"Beyoncé","BLACKPINK":"Blackpink","RUFUS DU SOL":"Rüfüs Du Sol","Djo":"Djo (musician)","Wednesday":"Wednesday (American band)","Geese":"Geese (band)","Gustaf":"Gustaf (band)","Scowl":"Scowl (band)","Petey USA":"Petey (musician)","MUNA":"Muna (band)","MARINA":"Marina Diamandis","Maná":"Maná","TWICE":"Twice (group)","YOASOBI":"Yoasobi","CAAMP":"Caamp"};
let metaCache={};try{metaCache=JSON.parse(localStorage.getItem('festivalArtistMeta')||'{}')}catch(e){}
function searchUrl(a){if(a.spotify_url)return a.spotify_url;if(metaCache[a.name]&&metaCache[a.name].spotify_url)return metaCache[a.name].spotify_url;if(VERIFIED_SPOTIFY[a.name])return VERIFIED_SPOTIFY[a.name];const q='artist:"'+a.name+'"';return 'https://open.spotify.com/search/'+encodeURIComponent(q)}
async function resolveArtistMeta(a){if(metaCache[a.name]&&(metaCache[a.name].image||metaCache[a.name].spotify_url))return metaCache[a.name];let out=metaCache[a.name]||{};if(VERIFIED_SPOTIFY[a.name])out.spotify_url=VERIFIED_SPOTIFY[a.name];const title=WIKI_TITLES[a.name]||a.name;try{const wu='https://en.wikipedia.org/w/api.php?action=query&format=json&origin=*&prop=pageimages%7Cpageprops&piprop=thumbnail&pithumbsize=640&titles='+encodeURIComponent(title);const wr=await fetch(wu);const wj=await wr.json();const page=Object.values((wj.query||{}).pages||{})[0];if(page&&page.thumbnail&&page.thumbnail.source)out.image=page.thumbnail.source;const qid=page&&page.pageprops&&page.pageprops.wikibase_item;if(qid&&!out.spotify_url){const qu='https://www.wikidata.org/w/api.php?action=wbgetclaims&format=json&origin=*&entity='+encodeURIComponent(qid)+'&property=P1902';const qr=await fetch(qu);const qj=await qr.json();const claims=((qj.claims||{}).P1902)||[];const id=claims[0]&&claims[0].mainsnak&&claims[0].mainsnak.datavalue&&claims[0].mainsnak.datavalue.value;if(id)out.spotify_url='https://open.spotify.com/artist/'+id}}catch(e){}metaCache[a.name]=out;try{localStorage.setItem('festivalArtistMeta',JSON.stringify(metaCache))}catch(e){}return out}
function initials(name){return name.split(/\s+/).filter(Boolean).slice(0,2).map(x=>x[0]).join('').toUpperCase()}
function hydrateImage(el,a){if(!el)return;el.innerHTML='<span class="photo-fallback">'+initials(a.name)+'</span>';resolveArtistMeta(a).then(m=>{if(m.image){el.style.backgroundImage='url("'+m.image.replaceAll('"','%22')+'")';el.innerHTML=''}})}
function tooltip(text){return '<span class="tipwrap"><button type="button" class="tipbtn" aria-label="More information">ⓘ</button><span class="tipbubble">'+text+'</span></span>'}
function recentMarkets(){try{return JSON.parse(localStorage.getItem('festivalRecentMarkets')||'[]')}catch(e){return[]}}
function rememberMarket(name){let a=recentMarkets().filter(x=>x!==name);a.unshift(name);localStorage.setItem('festivalRecentMarkets',JSON.stringify(a.slice(0,5)))}
function hostInterest(artist){if(artist.draw_power>=92)return '📞 That booking gets several potential host markets calling your site team.';if(artist.draw_power>=78)return '📍 The site team reports a little more interest after that announcement.';return ''}
function start(){state={budget:100,phase:1,pass:true,lineup:[],seen:new Set(),market:null,offer:[],message:'',revealed:false,offerSets:[]};$('landing').classList.add('hidden');$('results').classList.add('hidden');$('game').classList.remove('hidden');$('newGameTop').classList.remove('hidden');newOffer();render()}
function newOffer(){if($('scoutDrawer')){$('scoutDrawer').classList.add('hidden');$('scoutDrawer').innerHTML=''}state.offer=E.chooseOffer(D.artists,state.budget,state.phase,state.seen,Math.random,6-state.phase);state.offer.forEach(x=>state.seen.add(x.artist.name))}
function render(){const ph=phases[state.phase-1];$('game').className='phase-'+state.phase;$('budget').textContent='$'+state.budget;$('committed').textContent='$'+(100-state.budget)+' committed';$('phase').textContent=ph.name;$('pass').textContent=state.pass?'Available':'Used';$('location').textContent=state.revealed?state.market.name:'Scouting';$('phaseKicker').textContent=ph.when+' · '+ph.kicker;$('phaseTitle').textContent=ph.name;$('progress').innerHTML=phases.map((p,i)=>'<span class="progressdot '+(i<state.phase?'done':'')+'"></span>').join('');$('phaseTip').innerHTML=ph.early?'⚡ <strong>Early Booking Rate</strong> '+tooltip('Artists are cheaper when you commit months ahead, before routing fills up and guarantees rise. The biggest acts still have enough leverage that their discount is capped.') : '';$('passBtn').disabled=!state.pass;$('passBtn').textContent=state.pass?'Make More Calls':'Extra Call Used';const msg=$('message');if(state.message){msg.textContent=state.message;msg.classList.remove('hidden')}else msg.classList.add('hidden');const r=$('cityReveal');if(state.revealed){const f=D.marketFlavor[state.market.name]||{teaser:'Your host city has its own musical personality.',refs:[]};document.documentElement.style.setProperty('--city-accent',cityAccent(state.market.name));r.innerHTML='<div class="city-stamp">HOST CITY REVEALED</div><div class="city-name">'+state.market.name+'</div><p>'+f.teaser+'</p><div class="cityrefs"><span>SOUNDS OF THE CITY</span>'+f.refs.join(' · ')+'</div>';r.classList.remove('hidden')}else r.classList.add('hidden');$('offers').innerHTML='';state.offer.forEach(o=>{const can=o.price<=state.budget,div=document.createElement('article');div.className='offer';const early=ph.early?'<div class="tag">⚡ Early Booking Rate</div>':'<div class="tag"></div>';const remainingSlots=5-state.phase;const after=state.budget-o.price;const risk=can&&remainingSlots>0&&after/(remainingSlots)<8?'<div class="risk">Big commitment, leaves $'+after+' for '+remainingSlots+' more addition'+(remainingSlots===1?'':'s')+'.</div>':'';div.innerHTML='<div class="offer-topline"><span>BOOKING OFFER</span><span>'+ph.when.toUpperCase()+'</span></div><div class="artist-photo"><span class="photo-fallback">'+initials(o.artist.name)+'</span></div><div class="artist-lockup"><h3>'+o.artist.name+'</h3><div class="price">$'+o.price+'</div></div>'+early+risk+'<div class="offer-actions"><button class="scout scoutbtn" type="button"><span class="spotifydot">♪</span>Catch a Show</button><button class="btn primary book">BOOK ACT</button></div>';hydrateImage(div.querySelector('.artist-photo'),o.artist);const b=div.querySelector('.book');b.disabled=!can||!o.safe;b.addEventListener('click',()=>book(o));div.querySelector('.scoutbtn').addEventListener('click',()=>catchShow(o.artist));$('offers').appendChild(div)});const l=$('lineup');const ranked=[...state.lineup].sort((a,b)=>b.artist.draw_power-a.artist.draw_power);const slots=Array.from({length:5},(_,i)=>ranked[i]||null);l.className='lineup poster-lineup'+(!state.lineup.length?' empty':'');l.innerHTML='<div class="poster-city">'+(state.revealed?state.market.name:'HOST CITY TBD')+'</div><div class="poster-title">FESTIVAL SEASON</div><div class="poster-date">'+ph.when.toUpperCase()+' · LINEUP IN PROGRESS</div><div class="poster-acts">'+slots.map((x,i)=>x?'<div class="poster-act act-'+i+'"><span>'+x.artist.name+'</span><small>$'+x.price+'</small></div>':'<div class="poster-act poster-empty act-'+i+'">-</div>').join('')+'</div><div class="poster-footer">FIVE ACTS · ONE CITY · ONE SUMMER</div>'}
async function catchShow(a){const drawer=$('scoutDrawer');drawer.classList.remove('hidden');drawer.innerHTML='<h4>🎵 Catching a show: '+a.name+'</h4><div class="small muted">Pulling up the artist…</div>';const meta=await resolveArtistMeta(a);const exact=meta.spotify_url||a.spotify_url||VERIFIED_SPOTIFY[a.name];if(exact){const m=exact.match(/open\.spotify\.com\/artist\/([A-Za-z0-9]+)/);if(m){drawer.innerHTML='<h4>🎵 Catching a show: '+a.name+'</h4><iframe src="https://open.spotify.com/embed/artist/'+m[1]+'?utm_source=generator" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe><div class="small muted">Listen here, or <a href="'+exact+'" target="spotifyScout" rel="noopener">open '+a.name+' in Spotify ↗</a></div>';drawer.scrollIntoView({behavior:'smooth',block:'nearest'});return}}const url=searchUrl(a);drawer.innerHTML='<h4>🎵 Catching a show: '+a.name+'</h4><div class="small">Spotify could not be matched to an exact artist page automatically, so this act falls back to an exact-name Spotify search.</div><div style="margin-top:10px"><a class="scout" href="'+url+'" target="spotifyScout" rel="noopener"><span class="spotifydot">♪</span>Open in Spotify</a></div>';window.open(url,'spotifyScout')}
function book(o){state.offerSets.push(state.offer.map(x=>({artist:x.artist,price:x.price})));state.lineup.push(o);state.budget-=o.price;state.message=state.phase<=2?hostInterest(o.artist):'';if(state.phase===2){state.market=E.chooseMarket(D.markets,state.lineup,recentMarkets());state.revealed=true;rememberMarket(state.market.name);state.message='Put two names on the poster and the host offers start rolling in. One city gets the nod, and the rest of the lineup has a crowd to win.'}if(state.phase>=5){finish();return}state.phase++;newOffer();render()}
function usePass(){if(!state.pass)return;state.pass=false;state.message='You make one more round of calls. Those opportunities are gone, and a fresh set hits your desk.';newOffer();render()}
function comboKey(combo){return combo.map(x=>x.artist.name).join('|')}
function bestPossible(){let best=null;function rec(i,combo,cost){if(i===state.offerSets.length){if(cost<=100){const s=E.score(combo,state.market);if(!best||s.finalScore>best.score.finalScore)best={combo:[...combo],score:s,cost}}return}for(const x of state.offerSets[i])rec(i+1,[...combo,x],cost+x.price)}rec(0,[],0);return best}
function bestSteal(){let best=null;for(const x of state.lineup){const sig=E.marketSignal(x.artist,state.market);const v=(x.artist.draw_power+sig*3)/(x.price||1);if(!best||v>best.v)best={x,v}}return best&&best.x}
function biggestMiss(){const actual=E.score(state.lineup,state.market).finalScore;let best=null;const actualCost=state.lineup.reduce((s,x)=>s+x.price,0);for(let i=0;i<state.offerSets.length;i++){for(const alt of state.offerSets[i]){const chosen=state.lineup[i];if(alt.artist.name===chosen.artist.name)continue;const newCost=actualCost-chosen.price+alt.price;if(newCost>100)continue;const trial=[...state.lineup];trial[i]=alt;const sc=E.score(trial,state.market).finalScore;const gain=sc-actual;if(gain>.05&&(!best||gain>best.gain))best={alt,chosen,phase:i+1,gain}}}return best}
function loadBest(){try{return JSON.parse(localStorage.getItem('festivalBest')||'{}')}catch(e){return{}}}
function saveBest(s){const prev=loadBest(),flags={};if(!prev.score||s.finalScore>prev.score){prev.score=s.finalScore;flags.score=true}if(!prev.tickets||s.tickets>prev.tickets){prev.tickets=s.tickets;flags.tickets=true}if(prev.profitM==null||s.profitM>prev.profitM){prev.profitM=s.profitM;flags.profit=true}localStorage.setItem('festivalBest',JSON.stringify(prev));return{prev,flags}}
function overlapLabel(v){return v<.8?'Broad audience reach':v<2.2?'Healthy crossover':v<4?'Some crowd cannibalization':v<5.8?'Heavy fan overlap':'Too much of the same crowd'}
function artistBadges(x,idx,best){const b=[];const sig=E.marketSignal(x.artist,state.market);const optimal=best&&best.combo[idx]&&best.combo[idx].artist.name===x.artist.name;if(optimal)b.push('🏆 Best pick of this wave');if((x.artist.home_market_boosts||{})[state.market.name]>=7)b.push('🏠 Hometown hero');else if(sig>=4.3)b.push('🔥 Perfect local fit');else if(sig<=0.2)b.push('😬 Tough local sell');if(x.artist.draw_power>=94)b.push('⭐ Major ticket driver');else if(x.price<=12&&x.artist.draw_power>=62)b.push('💎 Under-the-radar win');if(b.length<2&&x.price<=18&&x.artist.draw_power>=70)b.push('💰 Great value');if(b.length<2&&idx<=1&&x.artist.draw_power>=88)b.push('⚡ Early commitment paid off');return b.slice(0,2)}
function lineupBadges(s){const b=[];const draws=state.lineup.map(x=>x.artist.draw_power).sort((a,b)=>b-a);const genres=new Set(state.lineup.flatMap(x=>x.artist.genres||[]));if(s.overlapPenalty<1.2)b.push('🌈 Broad appeal');else if(s.overlapPenalty>=5)b.push('👥 Genre lock-in');if(draws[0]-draws[4]<=18)b.push('🧱 Deep lineup');else if(draws[0]-draws[2]>=22)b.push('🎯 Top-heavy swing');if(s.localFit>=8)b.push('📍 Local love');if(genres.size>=8)b.push('🌀 Eclectic bill');if(100-state.budget>=97&&s.finalScore>=80)b.push('💼 Budget masterclass');return b.slice(0,2)}
function finish(){const s=E.score(state.lineup,state.market),best=bestPossible(),miss=biggestMiss(),steal=bestSteal(),pb=saveBest(s);$('game').classList.add('hidden');$('results').classList.remove('hidden');$('resultCity').textContent='📍 '+state.market.name;$('resultHeadline').textContent='Tickets are on sale…';$('tickets').textContent='0 / 50,000 tickets';$('sellthrough').textContent='';$('profit').textContent='';$('resultStory').textContent='';$('pbrow').innerHTML='';$('resultStats').innerHTML='<div class="statcard"><span>Lineup Strength '+tooltip('How much ticket demand your five artists create before the host city is considered. Every booking matters. Truly iconic acts create extra marquee demand, but a deep bill can still outperform one superstar surrounded by filler.')+'</span><strong>'+s.intrinsic.toFixed(1)+'</strong></div><div class="statcard"><span>Local Fit '+tooltip('How naturally the lineup connects with this city’s tastes and local identity. Hometown and regional acts can get an extra lift.')+'</span><strong>'+(s.localFit>=0?'+':'')+s.localFit.toFixed(1)+'</strong></div><div class="statcard"><span>Audience Reach '+tooltip('This looks at how much your artists chase the same fans. A little crossover helps the bill feel coherent; too much means the lineup keeps selling to the same people instead of widening the gate.')+'</span><strong>'+overlapLabel(s.overlapPenalty)+'</strong></div><div class="statcard"><span>Budget Used '+tooltip('How much of your $100 talent budget you spent. Leftover money has no hidden bonus or penalty, it simply represents talent you did not book.')+'</span><strong>$'+(100-state.budget)+'</strong></div>';$('scoreMath').textContent='Score math: '+s.intrinsic.toFixed(1)+' lineup '+(s.localFit>=0?'+ ':'− ')+Math.abs(s.localFit).toFixed(1)+' local fit − '+s.overlapPenalty.toFixed(1)+' overlap = '+s.finalScore.toFixed(1)+'.';
$('lineupBadges').innerHTML=lineupBadges(s).map(t=>'<span class="badge">'+t+'</span>').join('');$('resultLineup').innerHTML=state.lineup.map((x,i)=>'<div class="result-artist"><div class="result-artist-thumb" data-result-img="'+i+'"></div><div class="result-artist-body"><strong>'+x.artist.name+' · $'+x.price+'</strong><div class="meta">'+(x.artist.display_genres||[]).join(' · ')+'</div><div class="badges">'+artistBadges(x,i,best).map(t=>'<span class="badge">'+t+'</span>').join('')+'</div><a class="spotify-link" target="spotifyScout" rel="noopener" href="'+searchUrl(x.artist)+'">Catch a Show on Spotify ↗</a></div></div>').join('');state.lineup.forEach((x,i)=>hydrateImage(document.querySelector('[data-result-img="'+i+'"]'),x.artist));
const optimalNames=best.combo.map(x=>x.artist.name),actualNames=state.lineup.map(x=>x.artist.name);const optimalCount=actualNames.reduce((n,name,i)=>n+(name===optimalNames[i]?1:0),0);let awards='';if(comboKey(best.combo)===comboKey(state.lineup)){awards+='<div class="award"><h4>🏆 PERFECT BOOKING</h4><p>You chose the highest-scoring possible lineup from the five offer sets you played.</p></div>'}else{awards+='<div class="award"><h4>🧠 '+optimalCount+'/5 optimal wave picks</h4><p>The booking room found a stronger combination in hindsight.</p><div class="bestline"><strong>Best possible lineup:</strong> '+best.combo.map(x=>x.artist.name+' ($'+x.price+')').join(' · ')+'<br><strong>Best possible score:</strong> '+best.score.finalScore.toFixed(1)+'</div></div>'}if(steal)awards+='<div class="award"><h4>💎 Biggest steal: '+steal.artist.name+'</h4><p>A lot of draw and local appeal for the money you committed.</p></div>';if(miss)awards+='<div class="award"><h4>😬 Biggest miss: '+miss.alt.artist.name+'</h4><p>In hindsight, '+miss.alt.artist.name+' would have been the better choice than '+miss.chosen.artist.name+' during '+phases[miss.phase-1].name+'.</p></div>';else awards+='<div class="award"><h4>✅ No obvious missed upgrade</h4><p>Your five selections match the booking room’s preferred choices from the offer sets you played.</p></div>';$('awards').innerHTML=awards;
const f=D.marketFlavor[state.market.name];$('marketDebrief').textContent=f?f.teaser:'Every market has a different musical personality.';$('marketGenres').innerHTML=E.topMarketGenres(state.market).map(g=>'<span class="chip">'+prettyGenre(g)+'</span>').join('');
const rankedPoster=[...state.lineup].sort((a,b)=>b.artist.draw_power-a.artist.draw_power);$('finalPoster').innerHTML='<div class="final-poster-photos">'+rankedPoster.map((x,i)=>'<div class="final-poster-photo" data-final-img="'+i+'"></div>').join('')+'</div><div><div class="final-poster-city">'+state.market.name+' · '+(s.profitM>=0?'YEAR TWO SECURED':'FESTIVAL FOLDS')+'</div><div class="final-poster-title">FESTIVAL SEASON</div><div class="final-poster-sub">FINAL EDITION POSTER</div></div><div class="final-poster-acts">'+rankedPoster.map(x=>'<div class="final-poster-act">'+x.artist.name+'</div>').join('')+'</div><div class="final-poster-bottom"><span>'+s.tickets.toLocaleString()+' tickets</span><span>'+fmtMoneyM(s.profitM)+'</span><span>'+s.finalScore.toFixed(1)+' score</span></div>';rankedPoster.forEach((x,i)=>hydrateImage(document.querySelector('[data-final-img="'+i+'"]'),x.artist));
const steps=[{label:'Early onsale',n:Math.round(s.tickets*.36)},{label:'Full lineup announcement',n:Math.round(s.tickets*.74)},{label:'Final-week push',n:s.tickets}];let i=0;function revealStep(){if(i<steps.length){$('salesStage').textContent=steps[i].label;$('tickets').textContent=steps[i].n.toLocaleString()+' tickets sold';i++;setTimeout(revealStep,650);return}$('salesStage').textContent='FINAL RESULT';const survived=s.profitM>=0;const pools=survived?winningOutcomes:losingOutcomes;const band=pools.find(x=>s.finalScore<=x.max)||pools[pools.length-1];$('survival').textContent=survived?'YEAR TWO SECURED':'FESTIVAL FOLDS';$('survival').className='survival '+(survived?'good':'bad');$('resultHeadline').textContent=sample(band.h);$('tickets').textContent=s.tickets.toLocaleString()+' / 50,000 tickets';$('sellthrough').textContent=s.finalScore.toFixed(1)+' festival score';$('profit').textContent=fmtMoneyM(s.profitM);$('profit').className='profit '+(survived?'good':'bad');const breakEvenTickets=Math.round((.30+.70*.725)*50000),gap=Math.abs(s.tickets-breakEvenTickets);$('nearline').textContent=survived?gap.toLocaleString()+' tickets above the Year Two line':gap.toLocaleString()+' more tickets would have kept the festival alive';const ref=festivalReference(s);$('festivalRef').textContent=ref;if(ref)$('festivalRef').classList.remove('hidden');else $('festivalRef').classList.add('hidden');$('resultStory').textContent=sample(band.s);$('resultStory').classList.add('press-copy');const chips=[];if(pb.flags.score)chips.push('🏆 New best score');if(pb.flags.tickets)chips.push('🎟️ New ticket record');if(pb.flags.profit)chips.push('💰 New profit record');$('pbrow').innerHTML=chips.map(x=>'<span class="pbchip">'+x+'</span>').join('')}setTimeout(revealStep,350);window.scrollTo({top:0,behavior:'smooth'})}
$('startBtn').addEventListener('click',start);$('newGameTop').addEventListener('click',start);$('playAgain').addEventListener('click',start);$('passBtn').addEventListener('click',usePass);
})();
</script>
