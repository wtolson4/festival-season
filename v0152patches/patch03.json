[[".audience-meter-key{display:flex;justify-content:space-between;margin-top:-6px;font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:900}.reach-explainer strong{color:var(--ink)}",".reach-explainer strong{color:var(--ink)}"],["@media(max-width:760px){.audience-reach-panel{margin-top:12px}.audience-reach-head{align-items:flex-start;flex-direction:column;gap:3px}.performance-tier{font-size:28px}.performance-flavor{font-size:13px}.booked-genre-row{font-size:10px}}","@media(max-width:760px){.crowd-mix-strip{display:flex;position:sticky;top:0;z-index:30;width:100%;margin:-4px 0 12px;padding:9px 12px;border:2px solid var(--ink);background:var(--paper);color:var(--ink);align-items:center;gap:8px;text-align:left;box-shadow:0 3px 0 rgba(21,20,18,.10);cursor:pointer}.crowd-mix-strip span{font-size:9px;font-weight:900;letter-spacing:.11em;color:var(--muted)}.crowd-mix-strip strong{font-size:13px;text-transform:uppercase;margin-left:auto}.crowd-mix-strip em{font-style:normal;font-size:10px;color:var(--accent);font-weight:900}.audience-reach-panel{margin-top:12px}.audience-reach-head{align-items:flex-start;flex-direction:column;gap:3px}.performance-tier{font-size:28px}.performance-flavor{font-size:13px}.booked-genre-row{font-size:10px}.crowd-lane-row{grid-template-columns:minmax(110px,1.2fr) 72px 48px}}"]]